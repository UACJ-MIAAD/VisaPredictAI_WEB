{
  "name": "visapredictai-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "extract": "node scripts/extract-content.mjs",
    "build:rag": "node scripts/build-rag-index.mjs",
    "rag:check": "node scripts/rag-selfcheck.mjs",
    "rag:smoke": "node scripts/visabot-smoke.mjs",
    "rag:retr": "node scripts/rag-retrieval-eval.mjs",
    "rag:gate": "node scripts/rag-retrieval-eval.mjs --gate",
    "rag:golden": "node scripts/rag-golden-eval.mjs --split dev",
    "rag:golden:gate": "node scripts/rag-golden-eval.mjs --gate --split dev",
    "rag:golden:holdout": "node scripts/rag-golden-eval.mjs --split holdout",
    "rag:golden:split": "node scripts/golden-holdout-split.mjs",
    "check:visabot": "node scripts/visabot-dense-check.mjs",
    "prebuild": "node scripts/fetch-data.mjs && node scripts/build-stats.mjs && node scripts/extract-content.mjs && node scripts/build-rag-index.mjs && node scripts/rag-retrieval-eval.mjs --gate",
    "predev": "node scripts/build-stats.mjs && node scripts/extract-content.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build-csp.mjs",
    "build:offline": "FETCH_OFFLINE=1 node scripts/fetch-data.mjs && node scripts/build-stats.mjs && node scripts/extract-content.mjs && next build && node scripts/build-csp.mjs && node scripts/verify-build.mjs && node scripts/check-budgets.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"const fs=require('fs'),p='netlify/functions/rag-hashes.json';fs.existsSync(p)||fs.writeFileSync(p,'[]')\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build:offline && playwright test",
    "guard:test": "node scripts/test-code-guard.mjs",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "node -e \"const fs=require('fs'),p='netlify/functions/rag-hashes.json';fs.existsSync(p)||fs.writeFileSync(p,'[]')\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@netlify/blobs": "^10.7.13",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "katex": "^0.16.21",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.5",
    "next": "^15.5.25",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "netlify-plugin-cache": "^1.0.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.0",
    "postcss": "^8.5.26"
  }
}
